{
  "name": "circuito-combinacion",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check --error-on-warnings .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:size": "node scripts/check-file-size.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:size && npm run test",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.14",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
